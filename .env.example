# Database
DATABASE_URL=postgresql://localhost:5432/smarted

# Server
PORT=3001
SESSION_SECRET=change-this-to-a-random-secret-in-production
NODE_ENV=development

# Client URL (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# Anthropic AI (for card generation)
ANTHROPIC_API_KEY=your-api-key-here

# SMTP Configuration (optional in development)
# When not configured, emails are logged to the console instead of being sent.
# In production, configure with your SMTP provider (e.g., Mailgun, SES, Gmail).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@smarted.app
